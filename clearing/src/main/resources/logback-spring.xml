<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Spring Boot's console output (with trace and span IDs) plus an OpenTelemetry appender that ships
         every log event via OTLP to Loki. MDC entries become attributes, including Temporal's
         WorkflowId, RunId, ActivityType and Attempt. -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <captureMdcAttributes>*</captureMdcAttributes>
        <captureCodeAttributes>true</captureCodeAttributes>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="OTEL"/>
    </root>
</configuration>
