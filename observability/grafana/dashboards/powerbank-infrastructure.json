      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (task_type) (approximate_backlog_count{taskqueue=\"bank\"})",
          "legendFormat": "{{task_type}}",
          "instant": true,
          "range": false
