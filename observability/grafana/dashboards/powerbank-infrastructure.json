        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(postgresql_backends) / max(postgresql_connection_max)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
