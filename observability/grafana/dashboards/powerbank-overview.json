        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(bank_transfer_approval_wait_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
