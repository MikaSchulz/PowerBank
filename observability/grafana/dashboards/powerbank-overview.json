      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(bank_external_bank_call_milliseconds_count{outcome!=\"accepted\"}[5m])) / sum(rate(bank_external_bank_call_milliseconds_count[5m]))",
