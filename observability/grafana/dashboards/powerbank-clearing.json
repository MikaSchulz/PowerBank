    {
      "type": "timeseries",
      "id": 15,
      "title": "Messages from the banks per second",
      "description": "pacs.008 (payments), pacs.002 (creditor banks' answers) and pacs.028 (status inquiries) by HTTP status: 503 while the clearing house is down (chaos), 409 for duplicates or answers nobody waits for, 422 for payments that arrive after their deadline.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (uri, status) (rate(http_server_requests_milliseconds_count{service_name=\"clearing\", uri=~\"/api/clearing/pacs.*\"}[$__rate_interval]))",
          "legendFormat": "{{uri}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
