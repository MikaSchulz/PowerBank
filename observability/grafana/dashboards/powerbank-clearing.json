    {
      "type": "timeseries",
      "id": 6,
      "title": "Payments per minute by route",
      "description": "Debtor bank → creditor bank, by bank code: 99000001 is bank A (PowerBank), 99000002 bank B (Partner Bank); none: not a participant.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (debtor_bank, creditor_bank) (rate(clearing_payments_finished_total[$__rate_interval])) * 60",
          "legendFormat": "{{debtor_bank}} → {{creditor_bank}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Outcomes per minute",
      "description": "Settled, or rejected with the reason code: AC01 unknown account, AC04 closed, AC06 blocked, AB05 the creditor bank missed the deadline, RC01 not a participant, AM04 not enough liquidity.",
