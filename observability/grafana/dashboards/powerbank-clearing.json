            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(clearing_payment_duration_milliseconds_bucket{status=\"SETTLED\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(clearing_payment_duration_milliseconds_bucket{status=\"SETTLED\"}[$__rate_interval])))",
